rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every login (email) gets its own private academy, stored at
    //   academies/<that login's user id>/...
    // Only that same login can read or write it.
    // Other academies can NEVER see it, even if they use the same app.
    match /academies/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
